{
  "name": "kumihimo",
  "version": "0.0.1",
  "description": "Documents base on the relational model of annotation text blocks",
  "productName": "Kumihimo",
  "author": "JRC-Tojo <jrc.tojo@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "bun test --isolate",
    "bun:test": "bun test --isolate",
    "dev": "quasar dev -m pwa",
    "build": "quasar build -m pwa",
    "postinstall": "quasar prepare",
    "generate:plugin-sdk": "bun run scripts/generatePluginSdk.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@quasar/extras": "^1.16.4",
    "dayjs": "^1.11.20",
    "dexie": "^4.4.4",
    "konva": "^10.2.5",
    "onnxruntime-web": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "pinia": "^3.0.1",
    "ppu-paddle-ocr": "^6.1.0",
    "quasar": "^2.16.0",
    "register-service-worker": "^1.7.2",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.0",
    "vue": "^3.5.22",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.3.0",
    "vue-konva": "^3.4.0",
    "vue-router": "^5.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.19.11",
    "@types/uuid": "^11.0.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.4.27",
    "canvas": "^3.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.12.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6",
    "workbox-build": "^7.0.0",
    "workbox-cacheable-response": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22.12",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 10.0.0"
  }
}
